{
  "name": "opencode-plugin-orch",
  "version": "0.3.0",
  "description": "Workflow engine plugin for OpenCode — Anthropic-style agentic workflows (chain, routing, parallel, orchestrator-workers, evaluator-optimizer)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e.test.ts",
    "test:e2e:live": "ORCH_LIVE=1 bun test tests/e2e-live.test.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.7",
    "@opencode-ai/sdk": "^1.18.7",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": ["msgpackr-extract"]
  }
}
